	measure 'Quarter Net Sales PY Comparable' =
			VAR _End=[Context End Date]
			VAR _Y=YEAR(_End)-1
			VAR _Q=VALUE(RIGHT(SELECTEDVALUE(DimDate[Quarter]),1))
			VAR _CurrentQ=ROUNDUP(MONTH(_End)/3,0)
			VAR _S=DATE(_Y,(_Q-1)*3+1,1)
			VAR _Elapsed=DATEDIFF(DATE(YEAR(_End),(_CurrentQ-1)*3+1,1),_End,DAY)
			VAR _E=IF(_Q=_CurrentQ,MIN(EOMONTH(_S,2),_S+_Elapsed),EOMONTH(_S,2))
			RETURN IF(_Q>_CurrentQ || _S<[Data Min Date],BLANK(),CALCULATE([Net Sales],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],_S,_E)))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 04. Time Intelligence and Baseline
		lineageTag: 7c50f093-72df-455e-8a1a-4a7863fce005

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}


	measure 'Selected Country Label' = IF(ISFILTERED(DimCountry[Country]), IF(HASONEVALUE(DimCountry[Country]), SELECTEDVALUE(DimCountry[Country]), "Multiple Countries"), IF(ISFILTERED(fact_sales[Country]), IF(HASONEVALUE(fact_sales[Country]), SELECTEDVALUE(fact_sales[Country]), "Multiple Countries"), "All Countries"))
		displayFolder: 05. Dynamic Context and UI Labels

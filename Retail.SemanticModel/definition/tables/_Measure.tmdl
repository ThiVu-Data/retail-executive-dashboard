	measure 'Net AOV MTD' = DIVIDE([Net Sales MTD], [Orders MTD])
		formatString: "£"#,0.00; -"£"#,0.00; "£"0.00
		displayFolder: 01. Executive Overview
		lineageTag: bd7f7347-5e70-4f58-a776-270259908673

	measure 'Net Sales Prior Month Comparable' =
			VAR _End=[Context End Date]
			VAR _Start=DATE(YEAR(_End),MONTH(_End),1)
			VAR _CurrentPeriodEnd=EOMONTH(_Start,0)
			VAR _IsPartial=_End<_CurrentPeriodEnd
			VAR _PS=EDATE(_Start,-1)
			VAR _PE=IF(_IsPartial,MIN(EOMONTH(_PS,0),_PS+DAY(_End)-1),EOMONTH(_PS,0))
			VAR _DataMin=[Data Min Date]
			RETURN IF(_PS<_DataMin,BLANK(),CALCULATE([Net Sales],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],_PS,_PE)))
		displayFolder: 04. Time Intelligence and Baseline
		lineageTag: 90953e7a-a55f-4f9e-b1d2-21c5a4e9b0d9

	measure 'Orders Prior Month Comparable' =
			VAR _End=[Context End Date]
			VAR _Start=DATE(YEAR(_End),MONTH(_End),1)
			VAR _CurrentPeriodEnd=EOMONTH(_Start,0)
			VAR _IsPartial=_End<_CurrentPeriodEnd
			VAR _PS=EDATE(_Start,-1)
			VAR _PE=IF(_IsPartial,MIN(EOMONTH(_PS,0),_PS+DAY(_End)-1),EOMONTH(_PS,0))
			VAR _DataMin=[Data Min Date]
			RETURN IF(_PS<_DataMin,BLANK(),CALCULATE([Orders],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],_PS,_PE)))
		displayFolder: 04. Time Intelligence and Baseline
		lineageTag: efe3d5b5-18d1-4594-a0a4-abf56581a1a0


	measure 'Context Label M' =
			VAR _End=[Context End Date]
			VAR _PrevStart=EDATE(DATE(YEAR(_End),MONTH(_End),1),-1)
			VAR _PrevEnd=MIN(EOMONTH(_PrevStart,0),_PrevStart+DAY(_End)-1)
			RETURN "Viewing " & FORMAT(_End,"MMM yyyy") & " through " & FORMAT(_End,"dd MMM") & " · compared with " & FORMAT(_PrevStart,"dd MMM") & "–" & FORMAT(_PrevEnd,"dd MMM yyyy") & " · " & [Selected Country Label]
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: e3bc849c-0b9d-40bc-9709-39f7f6a8e062

	measure 'Context Label Q' =
			VAR _End=[Context End Date]
			VAR _Start=DATE(YEAR(_End),(ROUNDUP(MONTH(_End)/3,0)-1)*3+1,1)
			VAR _IsPartial=_End<EOMONTH(_Start,2)
			VAR _Elapsed=DATEDIFF(_Start,_End,DAY)
			VAR _PS=EDATE(_Start,-3)
			VAR _PE=IF(_IsPartial,MIN(EOMONTH(_PS,2),_PS+_Elapsed),EOMONTH(_PS,2))
			VAR _Q="Q" & FORMAT(ROUNDUP(MONTH(_End)/3,0),"0") & " " & FORMAT(_End,"yyyy")
			VAR _Comp=IF(_PS<[Data Min Date],"prior-quarter comparison unavailable", "compared with " & FORMAT(_PS,"dd MMM") & "–" & FORMAT(_PE,"dd MMM yyyy"))
			RETURN "Viewing " & _Q & " through " & FORMAT(_End,"dd MMM") & " · " & _Comp & " · " & [Selected Country Label]
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: eec5883f-5246-4ec3-be46-3e8c1b9fee52

	measure 'Context Label Y' =
			VAR _End=[Context End Date]
			VAR _PS=DATE(YEAR(_End)-1,1,1)
			VAR _PE=IF(_End<DATE(YEAR(_End),12,31),DATE(YEAR(_End)-1,MONTH(_End),DAY(_End)),DATE(YEAR(_End)-1,12,31))
			VAR _Comp=IF(_PS<[Data Min Date],"Foundational Baseline Year", "compared with 01 Jan–" & FORMAT(_PE,"dd MMM yyyy"))
			RETURN "Viewing " & FORMAT(_End,"yyyy") & " through " & FORMAT(_End,"dd MMM") & " · " & _Comp & " · " & [Selected Country Label]
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 2e743f59-f026-4931-a550-2b57ff6ed181

	measure 'Decision Focus M' =
			VAR _Prior=[Net Sales Prior Month Comparable]
			VAR _RatePP=([Cancellation Rate MTD]-[Cancellation Rate Prior Month Comparable])*100
			VAR _CV=DIVIDE([Cancelled Value MTD]-[Cancelled Value Prior Month Comparable],[Cancelled Value Prior Month Comparable])
			VAR _CO=DIVIDE([Cancellation Orders MTD]-[Cancellation Orders Prior Month Comparable],[Cancellation Orders Prior Month Comparable])
			VAR _Orders=DIVIDE([Orders MTD]-[Orders Prior Month Comparable],[Orders Prior Month Comparable])
			VAR _AOV=DIVIDE([Net AOV MTD]-[Net AOV Prior Month Comparable],[Net AOV Prior Month Comparable])
			RETURN IF(ISBLANK(_Prior),"No comparable prior-month period is available.",SWITCH(TRUE(),_RatePP>=5&&ABS(_CO)<ABS(_CV)/3,"Cancelled value increased far faster than cancellation order count. Prioritize the highest-value cancelled orders and products for investigation.",_RatePP>=5,"Cancellation rate moved materially above the comparable prior month. Use Cancellation Analysis to locate timing and product concentration.",ABS(_Orders)>=0.03&&ABS(_AOV)<0.03,"Order volume changed while Net AOV stayed broadly stable, so the sales movement is more consistent with order volume than order value in this period.","No additional exception needs to be surfaced beyond the KPI cards and trend."))
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 3b6a0c8e-6ca7-44e6-8274-28322353506b

	measure 'Decision Focus Q' =
			VAR _Prior=[Net Sales Prior Quarter Comparable]
			VAR _RatePP=([Cancellation Rate QTD]-[Cancellation Rate Prior Quarter Comparable])*100
			VAR _CV=DIVIDE([Cancelled Value QTD]-[Cancelled Value Prior Quarter Comparable Final],[Cancelled Value Prior Quarter Comparable Final])
			VAR _CO=DIVIDE([Cancellation Orders QTD]-[Cancellation Orders Prior Quarter Comparable Final],[Cancellation Orders Prior Quarter Comparable Final])
			VAR _Orders=DIVIDE([Orders QTD]-[Orders Prior Quarter Comparable],[Orders Prior Quarter Comparable])
			VAR _AOV=DIVIDE([Net AOV QTD]-[Net AOV Prior Quarter Comparable],[Net AOV Prior Quarter Comparable])
			RETURN IF(ISBLANK(_Prior),"No comparable prior-quarter period is available.",SWITCH(TRUE(),_RatePP>=5&&ABS(_CO)<ABS(_CV)/3,"Cancelled value increased far faster than cancellation order count. Prioritize the highest-value cancelled orders and products for investigation.",_RatePP>=5,"Cancellation rate moved materially above the comparable prior quarter. Use Cancellation Analysis to locate timing and product concentration.",ABS(_Orders)>=0.03&&ABS(_AOV)<0.03,"Order volume changed while Net AOV stayed broadly stable, so the sales movement is more consistent with order volume than order value in this period.","No additional exception needs to be surfaced beyond the KPI cards and trend."))
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: b511686b-4b15-4eb9-b0e7-bbcb36b4a885

	measure 'Decision Focus Y' =
			VAR _End = [Context End Date]
			VAR _Prior = [Net Sales PY YTD Comparable]
			VAR _RatePP = ([Cancellation Rate YTD] - [Cancellation Rate PY YTD Comparable]) * 100
			VAR _Orders = DIVIDE([Orders YTD] - [Orders PY YTD Comparable], [Orders PY YTD Comparable])
			VAR _AOV = DIVIDE([Net AOV YTD] - [Net AOV PY YTD Comparable], [Net AOV PY YTD Comparable])
			VAR _Sales = [Net Sales YTD]
			VAR _OrdersCount = [Orders YTD]
			VAR _SalesFormatted =
				IF(
					_Sales >= 1000000,
					"£" & FORMAT(_Sales / 1000000, "0.00M"),
					FORMAT(_Sales, "£#,0")
				)
			RETURN
				IF(
					ISBLANK(_Prior),
					"FY" & FORMAT(_End, "yyyy") & " serves as the foundational operating baseline (" & _SalesFormatted & " Net Sales across " & FORMAT(_OrdersCount, "#,0") & " orders). YoY variance tracking activates in FY" & FORMAT(YEAR(_End) + 1, "0") & ".",
					SWITCH(
						TRUE(),
						_RatePP >= 5, "Cancellation rate moved materially above the comparable prior year. Use Cancellation Analysis to locate timing and product concentration.",
						ABS(_Orders) >= 0.03 && ABS(_AOV) < 0.03, "Order volume changed while Net AOV stayed broadly stable, so the sales movement is more consistent with order volume than order value in this period.",
						"No additional exception needs to be surfaced beyond the KPI cards and trend."
					)
				)
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: c2f1564a-796f-4423-81bd-3c7ea856b4fd

	measure 'Data Min Date' =

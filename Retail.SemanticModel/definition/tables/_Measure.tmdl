table _Measure
	lineageTag: 92be779b-349a-4deb-81df-3aca43cf33f4

	measure 'Net Sales' = SUM(fact_sales[LineAmount])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 01. Executive Overview
		lineageTag: f417c6f8-5e67-4a30-88f3-0f59a577a067

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Gross Sales' =
			
			CALCULATE(
			    SUM(fact_sales[LineAmount]),
			    fact_sales[TransactionStatus]="Active"
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 01. Executive Overview
		lineageTag: 4219a726-23ad-4f66-9c13-3e395700e25c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Cancelled Values' =
			
			ABS(
			    CALCULATE(
			        SUM(fact_sales[LineAmount]),
			        fact_sales[TransactionStatus]="Cancellation"
			   )
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 03. Cancellation Analysis
		lineageTag: 857dc2af-81b2-441f-94bb-da22546de82d

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Orders =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_sales[Invoice]),
			    fact_sales[TransactionStatus]="Active"
			)
		formatString: 0
		displayFolder: 01. Executive Overview

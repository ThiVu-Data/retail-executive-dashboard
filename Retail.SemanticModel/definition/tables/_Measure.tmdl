	measure 'December Actual Cumulative' =
			
			VAR _AxisDay = MAX(DimDate[DayOfMonth])
			VAR _End = [Context End Date]
			VAR _CY = YEAR(_End)
			VAR _CM = MONTH(_End)
			VAR _CurrentDay = DAY(_End)
			VAR _MaxMonthDay = DAY(EOMONTH(_End, 0))
			VAR _CutoffDay = MIN(_CurrentDay, _MaxMonthDay)
			RETURN
			    IF(
			        _AxisDay <= _CutoffDay,
			        CALCULATE(
			            [Net Sales],
			            FILTER(
			                ALL(DimDate),
			                DimDate[Year] = _CY &&
			                DimDate[MonthNo] = _CM &&
			                DimDate[DayOfMonth] <= _AxisDay
			            )
			        ),
			        BLANK()
			    )
		displayFolder: 01. Executive Overview
		lineageTag: 1b57f1da-e98f-4100-940a-1885c0314ab5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'December Projected Cumulative' = ```
			
			VAR _AxisDay = MAX(DimDate[DayOfMonth])
			VAR _End = [Context End Date]
			VAR _CY = YEAR(_End)
			VAR _CM = MONTH(_End)
			VAR _CurrentDay = DAY(_End)
			VAR _MaxMonthDay = DAY(EOMONTH(_End, 0))
			VAR _IsOpenMonth = (_End < EOMONTH(_End, 0)) && (_End = [Data Max Date])
			VAR _HistShare = 
			    AVERAGEX(
			        FILTER(ALL(DimDate[Year]), DimDate[Year] < _CY),
			        VAR _Y = DimDate[Year]
			        VAR _ToDay = CALCULATE([Net Sales], FILTER(ALL(DimDate), DimDate[Year] = _Y && DimDate[MonthNo] = _CM && DimDate[DayOfMonth] <= _AxisDay))
			        VAR _Full = CALCULATE([Net Sales], FILTER(ALL(DimDate), DimDate[Year] = _Y && DimDate[MonthNo] = _CM))
			        RETURN DIVIDE(_ToDay, _Full)
			    )
			VAR _HistPaceShareAtCutoff = 
			    AVERAGEX(
			        FILTER(ALL(DimDate[Year]), DimDate[Year] < _CY),
			        VAR _Y = DimDate[Year]
			        VAR _ToDay = CALCULATE([Net Sales], FILTER(ALL(DimDate), DimDate[Year] = _Y && DimDate[MonthNo] = _CM && DimDate[DayOfMonth] <= _CurrentDay))
			        VAR _Full = CALCULATE([Net Sales], FILTER(ALL(DimDate), DimDate[Year] = _Y && DimDate[MonthNo] = _CM))
			        RETURN DIVIDE(_ToDay, _Full)
			    )
			VAR _ProjectedMonthEnd = DIVIDE([Net Sales MTD], _HistPaceShareAtCutoff)
			RETURN
			    IF(
			        _IsOpenMonth && _AxisDay >= _CurrentDay && _AxisDay <= _MaxMonthDay,
			        IF(_AxisDay = _CurrentDay, [December Actual Cumulative], _ProjectedMonthEnd * _HistShare),
			        BLANK()
			    )
			```
		displayFolder: 01. Executive Overview
		lineageTag: 8b4dd850-84fe-4cc8-b54f-c281efafdd36

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'December Historical Average Cumulative' =
			
			VAR _AxisDay = MAX(DimDate[DayOfMonth])
			VAR _End = [Context End Date]
			VAR _CY = YEAR(_End)
			VAR _CM = MONTH(_End)
			VAR _MaxMonthDay = DAY(EOMONTH(_End, 0))
			RETURN
			    IF(
			        _AxisDay <= _MaxMonthDay,
			        AVERAGEX(
			            FILTER(ALL(DimDate[Year]), DimDate[Year] < _CY),
			            VAR _Y = DimDate[Year]
			            RETURN
			                CALCULATE(
			                    [Net Sales],
			                    FILTER(
			                        ALL(DimDate),
			                        DimDate[Year] = _Y &&
			                        DimDate[MonthNo] = _CM &&
			                        DimDate[DayOfMonth] <= _AxisDay
			                    )
			                )
			        ),
			        BLANK()
			    )
		displayFolder: 01. Executive Overview
		lineageTag: 8036b0ed-2c2f-4ae6-a862-4f398dc2e543

		annotation PBI_FormatHint = {"isGeneralNumber":true}


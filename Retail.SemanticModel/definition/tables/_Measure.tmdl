	measure 'Quarter Net Sales Latest Year' =
			VAR _End=[Context End Date]
			VAR _Y=YEAR(_End)
			VAR _Q=VALUE(RIGHT(SELECTEDVALUE(DimDate[Quarter]),1))
			VAR _CurrentQ=ROUNDUP(MONTH(_End)/3,0)
			VAR _S=DATE(_Y,(_Q-1)*3+1,1)
			VAR _E=IF(_Q=_CurrentQ,_End,EOMONTH(_S,2))
			RETURN IF(_Q>_CurrentQ,BLANK(),CALCULATE([Net Sales],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],_S,_E)))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 01. Executive Overview
		lineageTag: 79bb4d22-6770-49c2-bc47-abe22d906b4b


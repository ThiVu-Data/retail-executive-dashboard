	measure 'New Customer Net Sales QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Net Sales],
					NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
					DimCustomer[FirstPurchaseDate] >= _Start,
					DimCustomer[FirstPurchaseDate] <= _End,
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340004

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Returning Customer Net Sales QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Net Sales],
					NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
					DimCustomer[FirstPurchaseDate] < _Start,
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340005

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'New Customer Orders QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Orders],
					NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
					DimCustomer[FirstPurchaseDate] >= _Start,
					DimCustomer[FirstPurchaseDate] <= _End,
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340006

	measure 'Returning Customer Orders QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Orders],
					NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
					DimCustomer[FirstPurchaseDate] < _Start,
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340007

	measure 'New Customer AOV QTD' = DIVIDE([New Customer Net Sales QTD], [New Customer Orders QTD], 0)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340008

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Returning Customer AOV QTD' = DIVIDE([Returning Customer Net Sales QTD], [Returning Customer Orders QTD], 0)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340009

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'New Customers Month QTD' =
			VAR _End = [Context End Date]
			VAR _Y = YEAR(_End)
			VAR _Q = ROUNDUP(MONTH(_End)/3, 0)
			VAR _M = SELECTEDVALUE(DimDate[MonthNo])
			VAR _S = DATE(_Y, _M, 1)
			VAR _InQ = ROUNDUP(_M/3, 0) = _Q
			VAR _E = IF(_M = MONTH(_End), _End, EOMONTH(_S, 0))
			RETURN
				IF(
					_InQ,
					CALCULATE(
						[Active Customers],
						NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
						DimCustomer[FirstPurchaseDate] >= _S,
						DimCustomer[FirstPurchaseDate] <= _E,
						REMOVEFILTERS(DimDate),
						DATESBETWEEN(DimDate[Date], _S, _E)
					)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340010

	measure 'Returning Customers Month QTD' =
			VAR _End = [Context End Date]
			VAR _Y = YEAR(_End)
			VAR _Q = ROUNDUP(MONTH(_End)/3, 0)
			VAR _M = SELECTEDVALUE(DimDate[MonthNo])
			VAR _S = DATE(_Y, _M, 1)
			VAR _InQ = ROUNDUP(_M/3, 0) = _Q
			VAR _E = IF(_M = MONTH(_End), _End, EOMONTH(_S, 0))
			RETURN
				IF(
					_InQ,
					CALCULATE(
						[Active Customers],
						NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
						DimCustomer[FirstPurchaseDate] < _S,
						REMOVEFILTERS(DimDate),
						DATESBETWEEN(DimDate[Date], _S, _E)
					)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340011

	measure 'Frequency Tier Customers QTD' =
			VAR _Tier = SELECTEDVALUE(DimFrequencyTier[TierOrder])
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(VALUES(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Orders", CALCULATE(DISTINCTCOUNT(fact_sales[Invoice]), fact_sales[TransactionStatus] = "Active")
					),
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					DATESBETWEEN(DimDate[Date], _Start, _End),
					REMOVEFILTERS(DimDate)
				)
			VAR _TierFiltered =
				FILTER(
					_CustTbl,
					[@Orders] > 0 &&
					SWITCH(
						_Tier,
						1, [@Orders] = 1,
						2, [@Orders] >= 2 && [@Orders] <= 3,
						3, [@Orders] >= 4 && [@Orders] <= 5,
						4, [@Orders] >= 6,
						TRUE()
					)
				)
			RETURN
				IF(
					ISBLANK(_Tier),
					[Active Customers QTD],
					COUNTROWS(_TierFiltered)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340012

	measure 'Frequency Tier Customer Share QTD' = DIVIDE([Frequency Tier Customers QTD], [Active Customers QTD], 0)
		formatString: 0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340013

	measure 'Frequency Tier Net Sales QTD' =
			VAR _Tier = SELECTEDVALUE(DimFrequencyTier[TierOrder])
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(VALUES(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Orders", CALCULATE(DISTINCTCOUNT(fact_sales[Invoice]), fact_sales[TransactionStatus] = "Active"),
						"@Sales", CALCULATE([Net Sales], fact_sales[IsIdentifiedCustomer] = TRUE())
					),
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					DATESBETWEEN(DimDate[Date], _Start, _End),
					REMOVEFILTERS(DimDate)
				)
			VAR _TierFiltered =
				FILTER(
					_CustTbl,
					[@Orders] > 0 &&
					SWITCH(
						_Tier,
						1, [@Orders] = 1,
						2, [@Orders] >= 2 && [@Orders] <= 3,
						3, [@Orders] >= 4 && [@Orders] <= 5,
						4, [@Orders] >= 6,
						TRUE()
					)
				)
			RETURN
				IF(
					ISBLANK(_Tier),
					[Identified Customer Sales QTD],
					SUMX(_TierFiltered, [@Sales])
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340014

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Frequency Tier Sales Share QTD' = DIVIDE([Frequency Tier Net Sales QTD], [Identified Customer Sales QTD], 0)
		formatString: 0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340015

	measure 'Lifecycle Customers QTD' =
			VAR _Order = SELECTEDVALUE(DimCustomerLifecycle[LifecycleOrder])
			RETURN
				SWITCH(
					_Order,
					1, [New Customers QTD],
					2, [Returning Customers QTD],
					[Active Customers QTD]
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340016

	measure 'Lifecycle Customer Share QTD' = DIVIDE([Lifecycle Customers QTD], [Active Customers QTD], 0)
		formatString: 0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340017

	measure 'Lifecycle Net Sales QTD' =
			VAR _Order = SELECTEDVALUE(DimCustomerLifecycle[LifecycleOrder])
			RETURN
				SWITCH(
					_Order,
					1, [New Customer Net Sales QTD],
					2, [Returning Customer Net Sales QTD],
					[Identified Customer Sales QTD]
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 01. Executive Overview
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340018

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Lifecycle Orders QTD' =
			VAR _Order = SELECTEDVALUE(DimCustomerLifecycle[LifecycleOrder])
			RETURN
				SWITCH(
					_Order,
					1, [New Customer Orders QTD],
					2, [Returning Customer Orders QTD],
					[New Customer Orders QTD] + [Returning Customer Orders QTD]
				)
		formatString: #,0
		displayFolder: 01. Executive Overview
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340020

	measure 'Lifecycle AOV QTD' = DIVIDE([Lifecycle Net Sales QTD], [Lifecycle Orders QTD], 0)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 01. Executive Overview
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340021

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Quarterly Strategic Narrative' =
			VAR _Active = [Active Customers QTD]
			VAR _New = [New Customers QTD]
			VAR _Ret = [Returning Customers QTD]
			VAR _NewPct = DIVIDE(_New, _Active, 0)
			VAR _RetPct = DIVIDE(_Ret, _Active, 0)
			VAR _RetSalesPct = DIVIDE([Returning Customer Net Sales QTD], [Identified Customer Sales QTD], 0)
			VAR _NewAOV = [New Customer AOV QTD]
			VAR _RetAOV = [Returning Customer AOV QTD]
			VAR _AOVDifference = DIVIDE(_RetAOV - _NewAOV, _NewAOV, 0)
			VAR _Tier4Sales =
				CALCULATE(
					[Frequency Tier Net Sales QTD],
					DimFrequencyTier[TierOrder] = 4
				)
			VAR _Tier4Pct = DIVIDE(_Tier4Sales, [Identified Customer Sales QTD], 0)
			RETURN
				"“Quarterly customer analysis examines base composition, ordering frequency, and cohort contribution.”" & UNICHAR(10) & UNICHAR(10) &
				"• Returning Customer Contribution: " & FORMAT(_RetPct, "0.0%") & " returning customers generate " & FORMAT(_RetSalesPct, "0.0%") & " of identified sales." & UNICHAR(10) &
				"• New Account Additions: " & FORMAT(_New, "#,0") & " new accounts (" & FORMAT(_NewPct, "0.0%") & ") observed in quarter. Average basket difference vs returning accounts is " & FORMAT(_AOVDifference, "+0.0%;-0.0%;0.0%") & "." & UNICHAR(10) &
				"• Order Frequency Depth: High-frequency accounts (≥6 orders) generate " & FORMAT(_Tier4Pct, "0.0%") & " of identified sales."
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340022

	measure 'Ref Cust Q Sub Active' = "Unique active accounts in quarter"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340023

	measure 'Ref Cust Q Sub New' =
			VAR _New = [New Customers QTD]
			VAR _Tot = [Active Customers QTD]
			RETURN FORMAT(DIVIDE(_New, _Tot, 0), "0.0%") & " of active base"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340024

	measure 'Ref Cust Q Sub Returning' =
			VAR _Ret = [Returning Customers QTD]
			VAR _Tot = [Active Customers QTD]
			RETURN FORMAT(DIVIDE(_Ret, _Tot, 0), "0.0%") & " existing accounts"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340025

	measure 'Ref Cust Q Sub Orders' = FORMAT([Identified Orders QTD], "#,0") & " orders / " & FORMAT([Active Customers QTD], "#,0") & " cust"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340026

	measure 'Ref Cust Q Sub Repeat' = FORMAT([Repeat Customers QTD], "#,0") & " cust with ≥2 orders"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340027

	measure 'Top 20 Customer Sales YTD' =
			SUMX(
				TOPN(
					20,
					FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
					[Net Sales YTD],
					DESC
				),
				[Net Sales YTD]
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340030

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Top 20 Customer Revenue Share YTD' = DIVIDE([Top 20 Customer Sales YTD], [Identified Customer Sales YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340031

	measure 'VIP and Premium Customers YTD' =
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Sales", [Net Sales YTD]
					),
					ALLSELECTED(DimCustomer[CustomerID])
				)
			RETURN
				COUNTROWS(FILTER(_CustTbl, [@Sales] >= 2000))
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340032

	measure 'VIP and Premium Sales YTD' =
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Sales", [Net Sales YTD]
					),
					ALLSELECTED(DimCustomer[CustomerID])
				)
			RETURN
				SUMX(FILTER(_CustTbl, [@Sales] >= 2000), [@Sales])
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340033

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'VIP and Premium Revenue Share YTD' = DIVIDE([VIP and Premium Sales YTD], [Identified Customer Sales YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340034

	measure 'Spend Tier Sales YTD' =
			VAR _TierName = SELECTEDVALUE(DimSpendTier[TierName])
			VAR _TierOrder = SELECTEDVALUE(DimSpendTier[TierOrder])
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Sales", [Net Sales YTD]
					),
					ALLSELECTED(DimCustomer[CustomerID])
				)
			VAR _TierFiltered =
				FILTER(
					_CustTbl,
					[@Sales] > 0 &&
					SWITCH(
						COALESCE(_TierOrder, 0),
						1, [@Sales] >= 5000,
						2, [@Sales] >= 2000 && [@Sales] < 5000,
						3, [@Sales] >= 500 && [@Sales] < 2000,
						4, [@Sales] < 500,
						SWITCH(
							_TierName,
							"£5K+", [@Sales] >= 5000,
							"£2K–£5K", [@Sales] >= 2000 && [@Sales] < 5000,
							"£2K-£5K", [@Sales] >= 2000 && [@Sales] < 5000,
							"£500–£2K", [@Sales] >= 500 && [@Sales] < 2000,
							"£500-£2K", [@Sales] >= 500 && [@Sales] < 2000,
							"< £500", [@Sales] < 500,
							"VIP Enterprise (≥ £5k)", [@Sales] >= 5000,
							"Premium (£2k - £5k)", [@Sales] >= 2000 && [@Sales] < 5000,
							"Core Regular (£500 - £2k)", [@Sales] >= 500 && [@Sales] < 2000,
							"Long Tail (< £500)", [@Sales] < 500,
							TRUE()
						)
					)
				)
			RETURN
				IF(
					ISBLANK(_TierName),
					[Identified Customer Sales YTD],
					SUMX(_TierFiltered, [@Sales])
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340035

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Spend Tier Share YTD' = DIVIDE([Spend Tier Sales YTD], [Identified Customer Sales YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340036

	measure 'Spend Tier Customers YTD' =
			VAR _TierName = SELECTEDVALUE(DimSpendTier[TierName])
			VAR _TierOrder = SELECTEDVALUE(DimSpendTier[TierOrder])
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Sales", [Net Sales YTD]
					),
					ALLSELECTED(DimCustomer[CustomerID])
				)
			VAR _TierFiltered =
				FILTER(
					_CustTbl,
					[@Sales] > 0 &&
					SWITCH(
						COALESCE(_TierOrder, 0),
						1, [@Sales] >= 5000,
						2, [@Sales] >= 2000 && [@Sales] < 5000,
						3, [@Sales] >= 500 && [@Sales] < 2000,
						4, [@Sales] < 500,
						SWITCH(
							_TierName,
							"£5K+", [@Sales] >= 5000,
							"£2K–£5K", [@Sales] >= 2000 && [@Sales] < 5000,
							"£2K-£5K", [@Sales] >= 2000 && [@Sales] < 5000,
							"£500–£2K", [@Sales] >= 500 && [@Sales] < 2000,
							"£500-£2K", [@Sales] >= 500 && [@Sales] < 2000,
							"< £500", [@Sales] < 500,
							"VIP Enterprise (≥ £5k)", [@Sales] >= 5000,
							"Premium (£2k - £5k)", [@Sales] >= 2000 && [@Sales] < 5000,
							"Core Regular (£500 - £2k)", [@Sales] >= 500 && [@Sales] < 2000,
							"Long Tail (< £500)", [@Sales] < 500,
							TRUE()
						)
					)
				)
			RETURN
				IF(
					ISBLANK(_TierName),
					[Active Customers YTD],
					COUNTROWS(_TierFiltered)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340037

	measure 'Decile Sales YTD' =
			VAR _Order = SELECTEDVALUE(DimCustomerDecile[DecileOrder])
			VAR _TotCust = [Active Customers YTD]
			VAR _TopNCur = ROUND(_Order * 0.10 * _TotCust, 0)
			VAR _TopNPrev = ROUND((_Order - 1) * 0.10 * _TotCust, 0)
			VAR _CustTbl = FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID]))
			VAR _SalesCur =
				IF(
					_Order >= 1 && _Order <= 10,
					SUMX(
						TOPN(_TopNCur, _CustTbl, [Net Sales YTD], DESC),
						[Net Sales YTD]
					),
					BLANK()
				)
			VAR _SalesPrev =
				IF(
					_Order > 1 && _Order <= 10,
					SUMX(
						TOPN(_TopNPrev, _CustTbl, [Net Sales YTD], DESC),
						[Net Sales YTD]
					),
					0
				)
			RETURN
				IF(
					ISBLANK(_Order),
					[Identified Customer Sales YTD],
					_SalesCur - _SalesPrev
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340038

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Decile Cumulative Share YTD' =
			VAR _Order = SELECTEDVALUE(DimCustomerDecile[DecileOrder])
			VAR _TotCust = [Active Customers YTD]
			VAR _TopNCur = ROUND(_Order * 0.10 * _TotCust, 0)
			VAR _CustTbl = FILTER(ALLSELECTED(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID]))
			VAR _SalesCur =
				IF(
					_Order >= 1 && _Order <= 10,
					SUMX(
						TOPN(_TopNCur, _CustTbl, [Net Sales YTD], DESC),
						[Net Sales YTD]
					),
					BLANK()
				)
			RETURN
				DIVIDE(_SalesCur, [Identified Customer Sales YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340039

	measure 'Repeat Status Net Sales YTD' =
			VAR _Order = SELECTEDVALUE(DimRepeatStatus[RepeatOrder])
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), 1, 1)
			VAR _CustTbl =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(VALUES(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Orders", CALCULATE(DISTINCTCOUNT(fact_sales[Invoice]), fact_sales[TransactionStatus] = "Active"),
						"@Sales", CALCULATE([Net Sales], fact_sales[IsIdentifiedCustomer] = TRUE())
					),
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					DATESBETWEEN(DimDate[Date], _Start, _End),
					REMOVEFILTERS(DimDate)
				)
			VAR _Filtered =
				FILTER(
					_CustTbl,
					[@Orders] > 0 &&
					SWITCH(
						_Order,
						1, [@Orders] >= 2,
						2, [@Orders] = 1,
						TRUE()
					)
				)
			RETURN
				IF(
					ISBLANK(_Order),
					[Identified Customer Sales YTD],
					SUMX(_Filtered, [@Sales])
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340041

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Repeat Status Sales Share YTD' = DIVIDE([Repeat Status Net Sales YTD], [Identified Customer Sales YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340042

	measure 'Ref Cust Y Sub Active' = "Unique identified active accounts"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340043

	measure 'Ref Cust Y Sub Top5' =
			VAR _S = [Top 5 Customer Sales YTD]
			RETURN "£" & FORMAT(_S, "#,0") & " from Top 5 accounts"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340044

	measure 'Ref Cust Y Sub Top20' =
			VAR _S = [Top 20 Customer Sales YTD]
			RETURN "£" & FORMAT(_S, "#,0") & " from Top 20 accounts"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340045

	measure 'Ref Cust Y Sub VIPPrem' =
			VAR _C = [VIP and Premium Customers YTD]
			VAR _S = [VIP and Premium Sales YTD]
			RETURN FORMAT(_C, "#,0") & " accounts generate £" & FORMAT(_S, "#,0")
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340046

	measure 'Ref Cust Y Sub Base' = "100% of tracked customer revenue"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340047

	measure 'Annual Customer Strategic Narrative' =
			VAR _Top5Pct = [Top 5 Customer Revenue Share YTD]
			VAR _Top5Sales = [Top 5 Customer Sales YTD]
			VAR _Top20Pct = [Top 20 Customer Revenue Share YTD]
			VAR _Top20Sales = [Top 20 Customer Sales YTD]
			VAR _VIPSales = CALCULATE([Spend Tier Sales YTD], DimSpendTier[TierOrder] = 1)
			VAR _VIPPct = CALCULATE([Spend Tier Share YTD], DimSpendTier[TierOrder] = 1)
			VAR _VIPCust = CALCULATE([Spend Tier Customers YTD], DimSpendTier[TierOrder] = 1)
			VAR _TailCust = CALCULATE([Spend Tier Customers YTD], DimSpendTier[TierOrder] = 4)
			VAR _TailSales = CALCULATE([Spend Tier Sales YTD], DimSpendTier[TierOrder] = 4)
			VAR _TailPct = CALCULATE([Spend Tier Share YTD], DimSpendTier[TierOrder] = 4)
			VAR _Active = [Active Customers YTD]
			VAR _VIPPremSales = [VIP and Premium Sales YTD]
			VAR _VIPPremPct = [VIP and Premium Revenue Share YTD]
			VAR _VIPPremCust = [VIP and Premium Customers YTD]
			VAR _VIPPremCustPct = DIVIDE(_VIPPremCust, _Active, 0)
			RETURN
				"“Annual customer economics show value distribution across key account tiers.”" & UNICHAR(10) & UNICHAR(10) &
				"• Spend Tier Distribution: Top spend tiers (" & FORMAT(_VIPPremCust, "#,0") & " accounts, " & FORMAT(_VIPPremCustPct, "0.0%") & " of base) account for " & FORMAT(_VIPPremPct, "0.0%") & " of annual sales (" & FORMAT(_VIPPremSales, "£#,0") & ")." & UNICHAR(10) &
				"• Key Account Concentration: Top 20 accounts generate " & FORMAT(_Top20Pct, "0.0%") & " of revenue (" & FORMAT(_Top20Sales, "£#,0") & "), with Top 5 contributing " & FORMAT(_Top5Pct, "0.0%") & " (" & FORMAT(_Top5Sales, "£#,0") & ")." & UNICHAR(10) &
				"• £5K+ Spend Accounts: " & FORMAT(_VIPCust, "#,0") & " accounts (≥£5k) contribute " & FORMAT(_VIPPct, "0.0%") & " of sales (" & FORMAT(_VIPSales, "£#,0") & ")." & UNICHAR(10) &
				"• < £500 Spend Accounts: " & FORMAT(_TailCust, "#,0") & " accounts (<£500, " & FORMAT(DIVIDE(_TailCust, _Active, 0), "0.0%") & " of base) account for " & FORMAT(_TailPct, "0.0%") & " of sales (" & FORMAT(_TailSales, "£#,0") & ")."
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340048

	measure 'Customer Active Net Sales Share YTD' =
			VAR _CustSales = [Customer Active Net Sales]
			VAR _TotalIdentified =
				CALCULATE(
					[Customer Active Net Sales],
					ALLSELECTED(DimCustomer[CustomerID]),
					NOT ISBLANK(DimCustomer[CustomerID])
				)
			RETURN
				DIVIDE(_CustSales, _TotalIdentified, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340049

	measure 'Repeat Customer Sales Share YTD' = CALCULATE([Repeat Status Sales Share YTD], DimRepeatStatus[RepeatOrder] = 1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340051

	measure 'Annual Repeat Purchase Narrative' =
			VAR _TotCust = [Active Customers YTD]
			VAR _TotSales = [Identified Customer Sales YTD]
			VAR _RepCust = [Repeat Customers YTD]
			VAR _RepPctBase = DIVIDE(_RepCust, _TotCust, 0)
			VAR _RepSales = CALCULATE([Repeat Status Net Sales YTD], DimRepeatStatus[RepeatOrder] = 1)
			VAR _RepPctSales = DIVIDE(_RepSales, _TotSales, 0)
			VAR _RepARPU = DIVIDE(_RepSales, _RepCust, 0)
			VAR _OneCust = _TotCust - _RepCust
			VAR _OnePctBase = DIVIDE(_OneCust, _TotCust, 0)
			VAR _OneSales = CALCULATE([Repeat Status Net Sales YTD], DimRepeatStatus[RepeatOrder] = 2)
			VAR _OnePctSales = DIVIDE(_OneSales, _TotSales, 0)
			VAR _OneARPU = DIVIDE(_OneSales, _OneCust, 0)
			RETURN
				"REPEAT CUSTOMERS (≥ 2 orders)" & UNICHAR(10) &
				"• Accounts: " & FORMAT(_RepCust, "#,0") & " (" & FORMAT(_RepPctBase, "0.0%") & " Base)" & UNICHAR(10) &
				"• Net Sales: " & FORMAT(_RepSales, "£#,0") & " (" & FORMAT(_RepPctSales, "0.0%") & ")" & UNICHAR(10) &
				"• Annual ARPU: " & FORMAT(_RepARPU, "£#,0") & " / account" & UNICHAR(10) & UNICHAR(10) &
				"ONE-TIME BUYERS (1 order only)" & UNICHAR(10) &
				"• Accounts: " & FORMAT(_OneCust, "#,0") & " (" & FORMAT(_OnePctBase, "0.0%") & " Base)" & UNICHAR(10) &
				"• Net Sales: " & FORMAT(_OneSales, "£#,0") & " (" & FORMAT(_OnePctSales, "0.0%") & ")" & UNICHAR(10) &
				"• Annual ARPU: " & FORMAT(_OneARPU, "£#,0") & " / account"
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340052

	measure 'Normalized Cancelled Value YTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), 1, 1)
			VAR _OutlierLoss =
				CALCULATE(
					[Cancelled Values],
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End),
					fact_sales[StockCode] IN {"23843", "23166"},
					fact_sales[Quantity] < -50000
				)
			RETURN [Cancelled Value YTD] - _OutlierLoss
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340061

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Normalized Cancellation Rate YTD' = DIVIDE([Normalized Cancelled Value YTD], [Gross Sales YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340062

	measure 'Ref Can Y Normalized Rate' =
			VAR _Val = [Cancelled Value YTD]
			VAR _Norm = [Normalized Cancelled Value YTD]
			VAR _OutlierLoss = _Val - _Norm
			RETURN
				IF(
					_OutlierLoss > 0,
					"Excl. high-value outlier cancellations (" & FORMAT(_OutlierLoss, "£#,0") & ")",
					"Standard operational cancellations"
				)
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340064

	measure 'Order Size Cancelled Value MTD' =
			VAR _TierID = SELECTEDVALUE(DimCancellationOrderSize[OrderSizeTierID])
			VAR _TierName = SELECTEDVALUE(DimCancellationOrderSize[OrderSizeTier])
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), MONTH(_End), 1)
			VAR _CancelInvoices =
				CALCULATETABLE(
					ADDCOLUMNS(
						CALCULATETABLE(
							VALUES(fact_sales[Invoice]),
							fact_sales[IsCancellation] = TRUE()
						),
						"@InvoiceLoss", CALCULATE(ABS(SUM(fact_sales[LineAmount])))
					),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
			VAR _LargeLoss = SUMX(FILTER(_CancelInvoices, [@InvoiceLoss] > 500), [@InvoiceLoss])
			VAR _StandardLoss = SUMX(FILTER(_CancelInvoices, [@InvoiceLoss] <= 500), [@InvoiceLoss])
			VAR _IsLarge = _TierID = 1 || _TierName = "Large Orders (> £500)"
			VAR _IsStandard = _TierID = 2 || _TierName = "Standard Orders (≤ £500)"
			RETURN
				IF(
					_IsLarge,
					_LargeLoss,
					IF(
						_IsStandard,
						_StandardLoss,
						[Cancelled Value MTD]
					)
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340065

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Order Size Cancelled Share MTD' = DIVIDE([Order Size Cancelled Value MTD], [Cancelled Value MTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340066

	measure 'Order Size Wholesale Share Value MTD' = CALCULATE([Order Size Cancelled Share MTD], DimCancellationOrderSize[OrderSizeTierID] = 1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01. Executive Overview
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340067

	measure 'Repeat Status Cancelled Value QTD' =
			VAR _Order = SELECTEDVALUE(DimRepeatStatus[RepeatOrder])
			VAR _Status = SELECTEDVALUE(DimRepeatStatus[RepeatStatus])
			VAR _End = [Context End Date]
			VAR _QStart = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			VAR _CustOrders =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(VALUES(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@CustOrderCount", CALCULATE(DISTINCTCOUNT(fact_sales[Invoice]), fact_sales[TransactionStatus] = "Active")
					),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _QStart, _End)
				)
			VAR _RepeatCusts = SELECTCOLUMNS(FILTER(_CustOrders, [@CustOrderCount] >= 2), "ID", DimCustomer[CustomerID])
			VAR _OneCusts = SELECTCOLUMNS(FILTER(_CustOrders, [@CustOrderCount] = 1), "ID", DimCustomer[CustomerID])
			VAR _IsRepeat = _Order = 1 || _Status = "Repeat Customers (≥ 2 orders)"
			VAR _IsOne = _Order = 2 || _Status = "One-Time Buyers (1 order only)"
			RETURN
				IF(
					_IsRepeat,
					CALCULATE([Cancelled Value QTD], KEEPFILTERS(DimCustomer[CustomerID] IN _RepeatCusts)),
					IF(
						_IsOne,
						CALCULATE([Cancelled Value QTD], KEEPFILTERS(DimCustomer[CustomerID] IN _OneCusts)),
						[Cancelled Value QTD]
					)
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340068

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Repeat Status Cancelled Share QTD' = DIVIDE([Repeat Status Cancelled Value QTD], [Cancelled Value QTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340069

	measure 'Quarterly Repeat Loss Share Value QTD' = CALCULATE([Repeat Status Cancelled Share QTD], DimRepeatStatus[RepeatOrder] = 1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340070

	measure 'Loss Nature Cancelled Value YTD' =
			VAR _Type = SELECTEDVALUE(DimCancellationLossType[LossTypeID])
			VAR _TypeName = SELECTEDVALUE(DimCancellationLossType[LossType])
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), 1, 1)
			VAR _OutlierLoss =
				CALCULATE(
					[Cancelled Values],
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End),
					fact_sales[StockCode] IN {"23843", "23166"},
					fact_sales[Quantity] < -50000
				)
			VAR _StandardLoss = [Cancelled Value YTD] - _OutlierLoss
			VAR _IsOutlier = _Type = 1 || _TypeName = "Extreme Outlier Cancellations"
			VAR _IsStandard = _Type = 2 || _TypeName = "Standard Cancellations"
			RETURN
				IF(
					_IsOutlier,
					_OutlierLoss,
					IF(
						_IsStandard,
						_StandardLoss,
						[Cancelled Value YTD]
					)
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340071

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Loss Nature Cancelled Share YTD' = DIVIDE([Loss Nature Cancelled Value YTD], [Cancelled Value YTD], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340072

	measure 'Loss Nature Outlier Share Value YTD' = CALCULATE([Loss Nature Cancelled Share YTD], DimCancellationLossType[LossTypeID] = 1)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340073

	measure 'Daily Cancelled Value' =
			VAR _AxisDay = MAX(DimDate[DayOfMonth])
			VAR _End = [Context End Date]
			VAR _CY = YEAR(_End)
			VAR _CM = MONTH(_End)
			VAR _CurrentDay = DAY(_End)
			VAR _MaxMonthDay = DAY(EOMONTH(_End, 0))
			VAR _CutoffDay = MIN(_CurrentDay, _MaxMonthDay)
			RETURN
				IF(
					_AxisDay <= _CutoffDay,
					CALCULATE(
						[Cancelled Values],
						REMOVEFILTERS(DimDate),
						DimDate[Year] = _CY,
						DimDate[MonthNo] = _CM,
						DimDate[DayOfMonth] = _AxisDay
					)
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340074

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Daily Cancellation Rate' =
			VAR _AxisDay = MAX(DimDate[DayOfMonth])
			VAR _End = [Context End Date]
			VAR _CY = YEAR(_End)
			VAR _CM = MONTH(_End)
			VAR _CurrentDay = DAY(_End)
			VAR _MaxMonthDay = DAY(EOMONTH(_End, 0))
			VAR _CutoffDay = MIN(_CurrentDay, _MaxMonthDay)
			VAR _Loss =
				CALCULATE(
					[Cancelled Values],
					REMOVEFILTERS(DimDate),
					DimDate[Year] = _CY,
					DimDate[MonthNo] = _CM,
					DimDate[DayOfMonth] = _AxisDay
				)
			VAR _Gross =
				CALCULATE(
					[Gross Sales],
					REMOVEFILTERS(DimDate),
					DimDate[Year] = _CY,
					DimDate[MonthNo] = _CM,
					DimDate[DayOfMonth] = _AxisDay
				)
			RETURN
				IF(
					_AxisDay <= _CutoffDay && _Gross > 0,
					DIVIDE(_Loss, _Gross, 0)
				)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340075

	measure 'Current Quarter Monthly Cancelled Sales' =
			VAR _End = [Context End Date]
			VAR _Y = YEAR(_End)
			VAR _Q = ROUNDUP(MONTH(_End)/3, 0)
			VAR _M = SELECTEDVALUE(DimDate[MonthNo])
			VAR _S = DATE(_Y, _M, 1)
			VAR _InQ = ROUNDUP(_M/3, 0) = _Q
			VAR _E = IF(_M = MONTH(_End), _End, EOMONTH(_S, 0))
			RETURN IF(_InQ, CALCULATE([Cancelled Values], REMOVEFILTERS(DimDate), DATESBETWEEN(DimDate[Date], _S, _E)))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 04. Time Intelligence and Baseline
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340077

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Quarterly Cumulative Loss Trajectory' =
			VAR _End = [Context End Date]
			VAR _QStart = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			VAR _CurrentDate = MAX(DimDate[Date])
			VAR _CumCancel =
				CALCULATE(
					[Cancelled Values],
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _QStart, _CurrentDate)
				)
			RETURN
				IF(
					_CurrentDate >= _QStart && _CurrentDate <= _End,
					_CumCancel
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 01. Executive Overview
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340078

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Spend Tier Cancelled Value YTD' =
			VAR _Order = SELECTEDVALUE(DimSpendTier[TierOrder])
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), 1, 1)
			VAR _CustSpend =
				CALCULATETABLE(
					ADDCOLUMNS(
						FILTER(VALUES(DimCustomer[CustomerID]), NOT ISBLANK(DimCustomer[CustomerID])),
						"@Sales", CALCULATE(SUM(fact_sales[LineAmount]), fact_sales[TransactionStatus] = "Active")
					),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
			VAR _VIP = SELECTCOLUMNS(FILTER(_CustSpend, [@Sales] >= 5000), "ID", DimCustomer[CustomerID])
			VAR _Prem = SELECTCOLUMNS(FILTER(_CustSpend, [@Sales] >= 2000 && [@Sales] < 5000), "ID", DimCustomer[CustomerID])
			VAR _Core = SELECTCOLUMNS(FILTER(_CustSpend, [@Sales] >= 500 && [@Sales] < 2000), "ID", DimCustomer[CustomerID])
			VAR _Tail = SELECTCOLUMNS(FILTER(_CustSpend, [@Sales] < 500), "ID", DimCustomer[CustomerID])
			RETURN
				SWITCH(
					_Order,
					1, CALCULATE([Cancelled Value YTD], KEEPFILTERS(DimCustomer[CustomerID] IN _VIP)),
					2, CALCULATE([Cancelled Value YTD], KEEPFILTERS(DimCustomer[CustomerID] IN _Prem)),
					3, CALCULATE([Cancelled Value YTD], KEEPFILTERS(DimCustomer[CustomerID] IN _Core)),
					4, CALCULATE([Cancelled Value YTD], KEEPFILTERS(DimCustomer[CustomerID] IN _Tail)),
					[Cancelled Value YTD]
				)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 03. Cancellation Analysis
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340085

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Tactical Quarterly Diagnostic Readout Q' =
			VAR _Val = [Cancelled Value QTD]
			VAR _Rate = [Cancellation Rate QTD]
			VAR _Orders = [Cancellation Orders QTD]
			VAR _Merch = [Cancelled Merchandise QTD]
			RETURN
				"TACTICAL QUARTERLY DIAGNOSIS" & UNICHAR(10) &
				"• Quarterly Cancelled Value: " & FORMAT(_Val, "£#,0") & " (" & FORMAT(_Rate, "0.0%") & " cancellation rate)" & UNICHAR(10) &
				"• Merchandise Impact: " & FORMAT(_Merch, "£#,0") & " across " & FORMAT(_Orders, "#,0") & " cancelled invoices" & UNICHAR(10) &
				"• Market Focus: Cancellation concentration varies across international and domestic destinations." & UNICHAR(10) &
				"• Recommended Investigation: Audit top cancelled product SKUs and large-quantity order lines in the quarter."
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340080

	measure 'Executive Strategic Loss Readout Y' =
			VAR _Val = [Cancelled Value YTD]
			VAR _RepRate = [Cancellation Rate YTD]
			VAR _NormRate = [Normalized Cancellation Rate YTD]
			VAR _OutlierLoss = _Val - [Normalized Cancelled Value YTD]
			VAR _OutlierPct = DIVIDE(_OutlierLoss, _Val, 0)
			VAR _OutlierReadout =
				IF(
					_OutlierLoss > 0,
					"High-value outlier orders account for " & FORMAT(_OutlierLoss, "£#,0") & " (" & FORMAT(_OutlierPct, "0.0%") & "). Normalized rate is " & FORMAT(_NormRate, "0.0%") & ".",
					"No single-order high-value anomalies detected in the selected context (Normalized rate matches reported rate at " & FORMAT(_RepRate, "0.0%") & ")."
				)
			RETURN
				"EXECUTIVE STRATEGIC CANCELLATION REVIEW" & UNICHAR(10) &
				"• Reported vs Normalized: Total cancelled value is " & FORMAT(_Val, "£#,0") & " (" & FORMAT(_RepRate, "0.0%") & "). " & _OutlierReadout & UNICHAR(10) & UNICHAR(10) &
				"RECOMMENDED INVESTIGATION:" & UNICHAR(10) &
				"1. High-Value Order Audit: Review individual transaction records > £5,000 for product concentration." & UNICHAR(10) &
				"2. Merchandise Review: Cross-examine high-cancellation SKUs against overall sales velocity." & UNICHAR(10) &
				"3. Account Concentration: Check whether repeat cancellations are concentrated within specific customer accounts."
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340081

	measure 'Identified Orders QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Orders],
					fact_sales[IsIdentifiedCustomer] = TRUE(),
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 8f3e1b2a-4c5d-6e7f-8a9b-0c1d2e3f4a5b

	column Column
		formatString: 0
		lineageTag: 8ac8bf5f-8af5-4b04-bdf7-0b7b55b7c5e1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Measure = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 0def761416ca4c0dbf807f98e54f12bb

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}


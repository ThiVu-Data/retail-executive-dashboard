	measure 'Context End Date' =
			VAR _DataMax =
			    CALCULATE(
			        MAX(fact_sales[InvoiceDate_Date]),
			        REMOVEFILTERS()
			    )
			VAR _MonthStart = SELECTEDVALUE(PeriodMonth[PeriodStart])
			VAR _QuarterStart = SELECTEDVALUE(PeriodQuarter[PeriodStart])
			VAR _Year = SELECTEDVALUE(PeriodYear[Year])
			VAR _RequestedEnd =
				SWITCH(
					TRUE(),
					NOT ISBLANK(_MonthStart), EOMONTH(_MonthStart, 0),
					NOT ISBLANK(_QuarterStart), EOMONTH(_QuarterStart, 2),
					NOT ISBLANK(_Year), DATE(_Year, 12, 31),
					_DataMax
				)
			RETURN MIN(_DataMax, _RequestedEnd)
		formatString: dd MMM yyyy
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 7bd4a443-4b97-4627-9128-90cab8d5ba5f

	measure 'Net Sales MTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), MONTH(_End), 1)
			RETURN CALCULATE([Net Sales], REMOVEFILTERS(DimDate), DATESBETWEEN(DimDate[Date], _Start, _End))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: 01. Executive Overview
		lineageTag: 9e44d099-f8f3-4208-b64f-2a74721bcf5f

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}


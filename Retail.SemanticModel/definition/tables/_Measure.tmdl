	measure 'Active Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_sales[Customer ID]),
			    fact_sales[TransactionStatus]="Active",
			    fact_sales[IsIdentifiedCustomer]=TRUE()
			)
		formatString: 0
		displayFolder: 02. Customer Intelligence
		lineageTag: b09527ac-b5a2-4dcb-bc89-4400876840e2

	measure 'Repeat Customers' =
			
			COUNTROWS(
			    FILTER(
			        FILTER(
			            VALUES(DimCustomer[CustomerID]),
			            NOT ISBLANK(DimCustomer[CustomerID])
			        ),
			        CALCULATE(
			            DISTINCTCOUNT(fact_sales[Invoice]),
			            fact_sales[TransactionStatus]="Active"
			        )>=2
			    )
			)
		formatString: 0
		displayFolder: 02. Customer Intelligence
		lineageTag: 8919b65e-f169-4dcc-814c-efa7677d0116

	measure 'Net Sales PY' =
			

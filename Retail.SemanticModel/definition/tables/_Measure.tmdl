	measure 'Net Sales Prior Quarter Comparable' =
			VAR _End=[Context End Date]
			VAR _Start=DATE(YEAR(_End),(ROUNDUP(MONTH(_End)/3,0)-1)*3+1,1)
			VAR _CurrentPeriodEnd=EOMONTH(_Start,2)
			VAR _IsPartial=_End<_CurrentPeriodEnd
			VAR _Elapsed=DATEDIFF(_Start,_End,DAY)
			VAR _PS=EDATE(_Start,-3)
			VAR _PE=IF(_IsPartial,MIN(EOMONTH(_PS,2),_PS+_Elapsed),EOMONTH(_PS,2))
			RETURN IF(_PS<[Data Min Date],BLANK(),CALCULATE([Net Sales],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[Date],_PS,_PE)))
		displayFolder: 04. Time Intelligence and Baseline
		lineageTag: 91d12ed8-8667-46d9-bd03-4dd378318686


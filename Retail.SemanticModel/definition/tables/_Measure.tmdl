	measure 'Customer Diagnostic Narrative' = ```
			
			VAR _IsQuarter = ISFILTERED(PeriodQuarter[PeriodLabel])
			VAR _IsYear = ISFILTERED(PeriodYear[Year])
			
			VAR _Coverage = 
			    SWITCH(
			        TRUE(),
			        _IsQuarter, [Customer Identification Coverage QTD],
			        _IsYear, [Customer Identification Coverage YTD],
			        [Customer Identification Coverage MTD]
			    )
			
			VAR _RepeatRate = 
			    SWITCH(
			        TRUE(),
			        _IsQuarter, [Repeat Customer Rate QTD],
			        _IsYear, [Repeat Customer Rate YTD],
			        [Repeat Customer Rate MTD]
			    )
			
			VAR _RepeatCust = 
			    SWITCH(
			        TRUE(),
			        _IsQuarter, [Repeat Customers QTD],
			        _IsYear, [Repeat Customers YTD],
			        [Repeat Customers MTD]
			    )
			
			VAR _Top5Share = 
			    SWITCH(
			        TRUE(),
			        _IsQuarter, [Top 5 Customer Revenue Share QTD],
			        _IsYear, [Top 5 Customer Revenue Share YTD],
			        [Top 5 Customer Revenue Share MTD]
			    )
			
			RETURN
			    "• Identification Coverage: " & FORMAT(_Coverage, "0.0%") & " of Net sales is linked to identified customers." & UNICHAR(10) & UNICHAR(10) &
			    "• Repeat Activity: " & FORMAT(_RepeatCust, "#,0") & " customers placed more than 1 order, representing " & FORMAT(_RepeatRate, "0.0%") & " of active identified customers." & UNICHAR(10) & UNICHAR(10) &
			    "• Customer Concentration: Top 5 customers account for " & FORMAT(_Top5Share, "0.0%") & " of identified customer revenue in the selected period"
			```
		displayFolder: 05. Dynamic Context and UI Labels
		lineageTag: 6d7419a0-631c-4147-b14d-12b9261e26b0

	measure 'VIP Customer Country' =
			IF(
			    NOT HASONEVALUE(DimCustomer[CustomerID]),
			    "Top 5 Total",
			    VAR _C =
			        CALCULATE(
			            SELECTEDVALUE(fact_sales[Country]),
			            fact_sales[TransactionStatus] = "Active"
			        )
			    RETURN
			        IF(_C = "United Kingdom", "UK", COALESCE(_C, "Unknown"))
			)
		displayFolder: 02. Customer Intelligence
		lineageTag: 5b7e9a21-8c34-4b56-91e8-782a1d2f9a01

	measure 'Customer Segment Sales' = ```
			VAR _CurrentSegment = SELECTEDVALUE(DimCustomerSegment[SegmentName])
				
				-- 1. Total Identified sales in current filter context
				VAR _TotalIdentified = 
				    CALCULATE(
				        [Customer Active Net Sales],
				        fact_sales[IsIdentifiedCustomer] = TRUE()
				    )
				    
				-- 2. Guest Checkout sales in current filter context
				VAR _GuestCheckout = 
				    CALCULATE(
				        [Customer Active Net Sales],
				        fact_sales[IsIdentifiedCustomer] = FALSE()
				    )
				    
				-- 3. Top 5 VIP sales in current filter context
				VAR _Top5Table = 
				    TOPN(
				        5,
				        FILTER(
				            VALUES(DimCustomer[CustomerID]),
				            NOT ISBLANK(DimCustomer[CustomerID])
				        ),
				        [Customer Active Net Sales],
				        DESC
				    )
				VAR _Top5Sales = 
				    CALCULATE(
				        [Customer Active Net Sales],
				        KEEPFILTERS(_Top5Table)
				    )
				    
				-- 4. Core Base sales
				VAR _CoreBaseSales = MAX(0, _TotalIdentified - _Top5Sales)
				
				RETURN
				    IF(
				        ISINSCOPE(DimCustomerSegment[SegmentName]),
				        SWITCH(
				            _CurrentSegment,
				            "Core Identified Customers", _CoreBaseSales,
				            "Top 5 Customers", _Top5Sales,
				            "Unidentified Customer Sales", _GuestCheckout,
				            BLANK()
				        ),
				        [Customer Active Net Sales]
				    )
			```
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: 02. Customer Intelligence
		lineageTag: 9a8b7c6d-5e4f-3a2b-1c0d-987654321fed

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'New Customers QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Active Customers],
					NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
					DimCustomer[FirstPurchaseDate] >= _Start,
					DimCustomer[FirstPurchaseDate] <= _End,
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340001

	measure 'Returning Customers QTD' =
			VAR _End = [Context End Date]
			VAR _Start = DATE(YEAR(_End), (ROUNDUP(MONTH(_End)/3, 0) - 1) * 3 + 1, 1)
			RETURN
				CALCULATE(
					[Active Customers],
					NOT ISBLANK(DimCustomer[FirstPurchaseDate]),
					DimCustomer[FirstPurchaseDate] < _Start,
					REMOVEFILTERS(DimDate),
					DATESBETWEEN(DimDate[Date], _Start, _End)
				)
		formatString: #,0
		displayFolder: 02. Customer Intelligence
		lineageTag: 7a8b9c0d-1234-5678-90ab-cdef12340002

	measure 'Orders per Active Customer QTD' = DIVIDE([Identified Orders QTD], [Active Customers QTD], 0)

	column MonthStart =
			
			DATE(
			    DimDate[Year],
			    DimDate[MonthNo],
			    1
			)
		formatString: mmmm yyyy
		lineageTag: cdaaaeb4-64d6-4fea-9537-4241b7705de5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column QuarterStart = DATE(DimDate[Year], (VALUE(RIGHT(DimDate[Quarter],1))-1)*3+1, 1)
		lineageTag: 28f228f2-d177-43e2-bcb0-30c2e4f9d67a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column YearQuarter = FORMAT(DimDate[Year],"0") & " Q" & RIGHT(DimDate[Quarter],1)
		lineageTag: 9f8e2afb-6638-4c4c-b7ac-be0442d3e173
		summarizeBy: none
		sortByColumn: QuarterStart

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MINX ( fact_sales, fact_sales[InvoiceDate_Date] )
				VAR MaxDate =
				    EOMONTH ( MAXX ( fact_sales, fact_sales[InvoiceDate_Date] ), 0 )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( MinDate, MaxDate ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "MonthNo", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "YearMonth", FORMAT ( [Date], "MMM yyyy" ),
				    "YearMonthSort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "DayOfMonth", DAY ( [Date] ),
				    "DayOfWeekNo", WEEKDAY ( [Date], 2 ),
				    "DayOfWeek", FORMAT ( [Date], "ddd" )
				)

	annotation PBI_Id = a4f7ff63b362468f88094cdf561c3fbd

